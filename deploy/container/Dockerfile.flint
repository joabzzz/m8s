# Flint CUDA build for SM120 Blackwell. Public dependencies are prepared before
# offline compilation. Credentials and model weights are excluded. MeshLLM
# resolves and downloads the selected model when the admitted node starts.
FROM nvidia/cuda@sha256:61f6c08f2b59036cb935e56d1e31a6b64e3ae2c7ddb86d33fa0b044c7917b719 AS cuda-tools
FROM node@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS node-tools
FROM rust@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git cmake ninja-build pkg-config libssl-dev \
    libdbus-1-dev python3 build-essential clang libclang-dev mold \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tools /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install -g pnpm@10.34.5
ENV CARGO_BUILD_JOBS=2 CMAKE_BUILD_PARALLEL_LEVEL=2
RUN cargo install --locked --version 1.40.0 just \
    && cargo install --locked --version 0.16.0 sccache
COPY --from=cuda-tools /usr/local/cuda-12.8 /usr/local/cuda-12.8
ENV CUDAToolkit_ROOT=/usr/local/cuda-12.8 CUDACXX=/usr/local/cuda-12.8/bin/nvcc \
    LLAMA_STAGE_CUDA_ARCHITECTURES=120a MESH_LLM_CUDA_TOOLKIT_MAJOR=12
COPY artifacts.py /checks/artifacts.py
COPY mesh-source.tar /inputs/
ARG MESH_SOURCE_SHA256
RUN --network=none mkdir -p /src \
    && python3 /checks/artifacts.py unpack-source /inputs/mesh-source.tar "${MESH_SOURCE_SHA256}" /src/mesh
WORKDIR /src/mesh
# Preparation follows the native owner's pinned patch queue; no substitute ABI.
RUN cargo fetch --locked \
    && pnpm --dir mesh/crates/mesh-llm-ui install --frozen-lockfile \
    && scripts/prepare-llama.sh pinned
RUN apt-get update && apt-get install -y --no-install-recommends patchelf \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_NET_OFFLINE=true
WORKDIR /src/mesh
ARG TARGETARCH
COPY --from=cuda-tools /usr/share/doc/cuda-cudart-12-8/copyright /licenses/cuda-copyright
ENV MESH_LLM_CUDA_LICENSE_FILE=/licenses/cuda-copyright
RUN --network=none \
    --mount=type=cache,id=m8s-mesh-flint-cuda-target-${TARGETARCH},target=/src/mesh/target,sharing=locked \
    --mount=type=cache,id=m8s-mesh-flint-cuda-native-${TARGETARCH},target=/src/mesh/.deps/llama-build,sharing=locked \
    --mount=type=cache,id=m8s-mesh-flint-cuda-sccache-${TARGETARCH},target=/root/.cache/sccache,sharing=locked \
    just release-runtime-build cuda x86_64-unknown-linux-gnu \
    && just skippy-cli-release-build \
    && just release-host-build \
    && version="$(target/release/mesh-llm --version | awk '{print $NF}')" \
    && just release-bundle "v${version#v}" /out/release cuda x86_64 \
    && count=0 \
    && for archive in /out/release/mesh-llm-*.tar.gz; do \
        case "$archive" in /out/release/mesh-llm-v*) continue ;; esac; \
        cp "$archive" /out/mesh-bundle.tar.gz; count=$((count + 1)); \
    done && test "$count" -eq 1
RUN --network=none mkdir /out/product && tar -xzf /out/mesh-bundle.tar.gz -C /out/product \
    && python3 /checks/artifacts.py check-native /out/product/mesh-bundle/mesh-llm
# Keep m8s changes after native packaging so they cannot invalidate that build.
COPY m8s-source.tar /inputs/
ARG M8S_SOURCE_SHA256
RUN --network=none python3 /checks/artifacts.py unpack-source /inputs/m8s-source.tar "${M8S_SOURCE_SHA256}" /src/m8s
WORKDIR /src/m8s
RUN CARGO_NET_OFFLINE=false cargo fetch --locked
RUN --network=none cargo build --release --locked --offline -j2 -p m8s-cli -p m8s-agent \
    --features m8s-agent/vast-node,m8s-cli/prototype-container

FROM node@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates libgomp1 libdbus-1-3 libssl3 tini \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cuda-tools /usr/local/cuda-12.8/targets/x86_64-linux/lib/ /usr/local/cuda/lib64/
RUN printf '%s\n' /usr/local/cuda/lib64 /usr/local/nvidia/lib /usr/local/nvidia/lib64 > /etc/ld.so.conf.d/m8s-cuda.conf && ldconfig
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64 NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
COPY --from=build /out/product/mesh-bundle/ /opt/mesh/
COPY --from=build --chmod=0555 /src/m8s/target/release/m8s /usr/local/bin/m8s
COPY --from=build --chmod=0555 /src/m8s/target/release/m8s-agent /usr/local/bin/m8s-agent
COPY artifacts.py /usr/local/lib/m8s/artifacts.py
COPY model-artifact.json /etc/m8s/model-artifact.json
ENV MESH_LLM_NATIVE_RUNTIME_BUNDLE_DIR=/opt/mesh/native-runtimes \
    MESH_LLM_ANALYTICS=0 DO_NOT_TRACK=1
USER 65532:65532
RUN --network=none python3 /usr/local/lib/m8s/artifacts.py check-contract /etc/m8s/model-artifact.json \
    && python3 /usr/local/lib/m8s/artifacts.py check-native /opt/mesh/mesh-llm
# Vast wrapper: runtime only; model selection belongs to MeshLLM at node startup.
USER 0:0
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server \
    && rm -f /etc/ssh/ssh_host_* \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 m8s \
    && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /var/lib/m8s --shell /bin/sh --password '*' m8s \
    && mkdir -p /run/sshd /models /usr/share/doc/flint
COPY --chmod=0555 vast_provision.py /usr/local/lib/m8s/vast_provision.py
EXPOSE 2222/tcp
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/bin/python3", "/usr/local/lib/m8s/vast_provision.py", "serve"]
